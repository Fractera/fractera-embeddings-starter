# 418 (2026-10-06): @a2a-js/sdk 1.3.0 lists better-sqlite3 ^12 as an OPTIONAL peer for its SQLite task store, which this
# element does not use (its tasks live in lib/a2a/tasks.ts); the element keeps better-sqlite3 11. Without this, npm ci fails ERESOLVE.
legacy-peer-deps=true
# 626-2: onnxruntime-node's postinstall downloads its CUDA build (a GPU archive from GitHub) on every Linux x64 install, even with
# no GPU («nvcc not found. Assuming CUDA 12.»), and a failed download fails `npm ci`. The element counts on the CPU only.
onnxruntime-node-install-cuda=skip
